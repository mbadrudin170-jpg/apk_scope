# Backend settings
APP_DATA_DIR=/data
MAX_UPLOAD_MB=500
MOBSF_URL=http://mobsf:8000
MOBSF_API_KEY=replace-with-key-from-your-private-mobsf-instance
APP_API_TOKEN=replace-with-a-long-random-private-token
DECOMPILER_URL=http://decompiler:8001
DECOMPILER_WORKER_TOKEN=replace-with-a-different-long-random-worker-token
DECOMPILE_TIMEOUT_SECONDS=3600

# Do not expose this service to the public internet.
